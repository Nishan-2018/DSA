class Solution {
public:
    // Function to add two polynomial linked lists
    PolyNode* addPoly(PolyNode* poly1, PolyNode* poly2) {
        // Dummy node to start result list
        PolyNode* dummy = new PolyNode(0, 0);
        PolyNode* tail = dummy;

        // Traverse both polynomials
        while (poly1 && poly2) {
            if (poly1->power == poly2->power) {
                // Add coefficients if powers match
                int sum = poly1->coefficient + poly2->coefficient;
                if (sum != 0) {
                    tail->next = new PolyNode(sum, poly1->power);
                    tail = tail->next;
                }
                poly1 = poly1->next;
                poly2 = poly2->next;
            }
            else if (poly1->power > poly2->power) {
                tail->next = new PolyNode(poly1->coefficient, poly1->power);
                tail = tail->next;
                poly1 = poly1->next;
            }
            else {
                tail->next = new PolyNode(poly2->coefficient, poly2->power);
                tail = tail->next;
                poly2 = poly2->next;
            }
        }

        // Append remaining terms
        while (poly1) {
            tail->next = new PolyNode(poly1->coefficient, poly1->power);
            tail = tail->next;
            poly1 = poly1->next;
        }

        while (poly2) {
            tail->next = new PolyNode(poly2->coefficient, poly2->power);
            tail = tail->next;
            poly2 = poly2->next;
        }

        return dummy->next;
    }
};

