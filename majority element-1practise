class Solution {
public:
    int majorityElement(vector<int>& nums) {
        int arr[1000];
        int len=nums.size();
        for(int i=0;i<1000;i++)
        {
            arr[i]=0;
        }
        for(int i=0;i<len;i++)
        {
            arr[nums[i]]++;
        }
        for(int i=0;i<size(arr);i++)
        {
            if(arr[i]>=len/2)
            {
                return i;
            }
        }
        return 0;

        
    }
};
