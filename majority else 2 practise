class Solution {
public:
    vector<int> majorityElementTwo(vector<int>& nums) {
        int size=nums.size();
        int cnt1=0,cnt2=0;
        int e1=INT_MIN,e2=INT_MIN;
        for(int i=0;i<size;i++)
        {
            if(cnt1 == 0 && nums[i]!=e2)
            {
                e1=nums[i];
                cnt1=1;
            }
            else if(cnt2 == 0 && nums[i]!=e1)
            {
                e2=nums[i];
                cnt2++;
            }
            else if (nums[i] == e1) {
                // Increment count for el1
                cnt1++;
            } 
            else if (nums[i] == e2) {
                // Increment count for el2
                cnt2++; 
            } 
            else
            {
                cnt1--;
                cnt2--;
            }
        }
        cnt1 = 0, cnt2 = 0; 
        
        for (int i = 0; i < size; i++) {
            if (nums[i] == e1) {
                // Count occurrences of el1
                cnt1++; 
            }
            if (nums[i] == e2) {
                 // Count occurrences of el2
                cnt2++;
            }
        }
        int mini=size/3 +1;
        vector<int> result;
        if(cnt1 >=mini)
        {
            result.push_back(e1);
        }
        if(cnt2 >=mini && e1!=e2)
        {
            result.push_back(e2);
        }
        return result;
        
    }
};
